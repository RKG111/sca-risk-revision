# Every variable here maps to exactly one field on core.config.Settings.
# The shell scripts read this same file, so there is one place to change things.
# After editing the Joern or MCP values, run: python -m core.config

# ── LLM (drives both the probe agents and CVSS adjudication) ──────────────────
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_ITERATIONS=12

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5-coder:14b

# ── Optional hosted provider (LLM_PROVIDER=llmas) ─────────────────────────────
LLMAS_BASE_URL=https://your-llmas-endpoint/v1
LLMAS_API_KEY=your-llmas-api-key
LLMAS_MODEL=claude-sonnet-4-5

# ── Joern CPG server (./scripts/stack.sh -> joern-run.sh) ─────────────────────
JOERN_HOST=127.0.0.1
JOERN_PORT=16162
JOERN_AUTH_USERNAME=user
JOERN_AUTH_PASSWORD=password
JOERN_TIMEOUT_SECONDS=300
# Where the repo is mounted inside the Joern container.
JOERN_WORKSPACE_PATH=/app

# ── mcp-joern (FastMCP SSE in front of Joern) ────────────────────────────────
MCP_JOERN_HOST=127.0.0.1
MCP_JOERN_PORT=8001
MCP_JOERN_SSE_PATH=/sse

# ── Paths ────────────────────────────────────────────────────────────────────
BLUEPRINT_STORE_PATH=./blueprints
CODEBASE_ROOT=.

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info

# Ollama host/port used by ./scripts/stack.sh to start and health-check the server.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
# STACK_STOP_OLLAMA=1  # also stop ollama on ./scripts/stack.sh stop
