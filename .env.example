# ── LLMaS (Enterprise LLM-as-a-Service) ─────────────────────────────────────
# Used for: Blueprint Generation (Module 2) and Agentic Reasoning (Module 4)
LLMAS_BASE_URL=https://your-llmas-endpoint/v1
LLMAS_API_KEY=your-llmas-api-key
LLMAS_MODEL=claude-sonnet-4-5   # or whichever model slug LLMaS exposes

# ── Local Ollama (GPU VM, 24GB VRAM) ─────────────────────────────────────────
# Used for: embeddings and lighter analysis tasks
OLLAMA_BASE_URL=http://your-ollama-vm-ip:11434/v1
OLLAMA_API_KEY=ollama              # Ollama uses "ollama" as the dummy key
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REASONING_MODEL=qwen2.5-coder:32b

# ── NVD API ───────────────────────────────────────────────────────────────────
# Optional: without a key you get 5 req/30s; with key you get 50 req/30s
NVD_API_KEY=

# ── Joern CPG Engine ──────────────────────────────────────────────────────────
# Joern runs as a Docker container exposing its REST server
JOERN_HOST=localhost
JOERN_PORT=8080

# ── ChromaDB (local vector store) ────────────────────────────────────────────
CHROMADB_PERSIST_PATH=./.chromadb

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# ── Analysis Settings ─────────────────────────────────────────────────────────
# Path on disk where target codebases are mounted/accessible
CODEBASE_ROOT=/codebases
